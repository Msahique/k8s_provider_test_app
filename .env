# ----------------------------------------------------------------------------
# Provider app - LOCAL configuration (read by _load_dotenv in app.py).
#
# For running on a laptop. In Kubernetes these same names come from the
# ConfigMap in provider_app.yaml and this file is not in the image. A real
# environment variable always overrides a line here.
#
#   uvicorn app:app --port 8010 --reload      -> http://127.0.0.1:8010
#
# Port 8010, not 8000: the Pub/Sub BB uses 8000 locally.
# ----------------------------------------------------------------------------

# --- MySQL ------------------------------------------------------------------
# Only /health, /qry and the APIs tab need this. The Pub/Sub tab does not touch
# the database, so it works fine while the console shows "Database unavailable".
IM_DB_HOST=127.0.0.1
IM_DB_PORT=3306
IM_DB_USER=root
IM_DB_PASS=Blr@2025
IM_DB_NAME=

# --- Console ----------------------------------------------------------------
# Where inbox.json, api_logs.json and the cached Pub/Sub key are written.
# Leave this line commented out to use the folder app.py sits in - setting it
# to an EMPTY value is not the same thing, it really means "".
# IM_DATA_DIR=/app/data
IM_LOG_MAX=500
IM_INBOX_MAX=500
IM_LOG_HEALTH=false
IM_DEFAULT_ROOM=default-room

# --- Pub/Sub BB -------------------------------------------------------------
# Base URL of the Pub/Sub BB. Locally it is served at the host root (its
# ROOT_PATH is empty), so no path suffix. Empty switches the tab off.
PUBSUB_URL=http://127.0.0.1:8000

# The application code the Pub/Sub admin registered this app under, as a
# SUBSCRIBER. This app never registers itself - it only recognises which
# approved registration is its own and collects the key that was issued.
PUBSUB_APP_CODE=provider-app

# Optional: id of the approved registration. Set it when the admin hands it
# over, or when the BB's admin API is not reachable so it cannot be looked up.
PUBSUB_REQUEST_ID=

# Optional extra filters, for a BB carrying several registrations of the same
# application code. Empty = take whatever the BB issued.
PUBSUB_INSTANCE=
PUBSUB_MEMBER_CLASS=
PUBSUB_MEMBER_CODE=

# --- Pre-provisioned credentials (optional escape hatch) --------------------
# Leave BOTH empty for the normal flow. Setting them pins the app to a key
# handed over by hand and stops it fetching anything.
PUBSUB_API_KEY=
PUBSUB_BASE=

# --- PULL through the Information Mediator ----------------------------------
# direct (default) = this app polls the Pub/Sub BB itself.
# im               = the pull and its acknowledgement go to THIS APP'S OWN
#                    security gateway, which resolves the service id to the
#                    Pub/Sub BB. Catalog, subscriptions and collecting the API
#                    key stay direct - they are not published as IM services,
#                    so PUBSUB_URL is still required either way.
PUBSUB_TRANSPORT=direct

# This app's gateway (admin port) and its IM identity -> the IM-Consumer header.
SG_URL=http://127.0.0.1:8081
IM_INSTANCE=GOVSTACK
ENTITY_CLASS=GOV
ENTITY_CODE=2001
APPLICATION_CODE=provider-app

# The two services the Pub/Sub side published on its gateway.
PUBSUB_PULL_SERVICE=
PUBSUB_ACK_SERVICE=
